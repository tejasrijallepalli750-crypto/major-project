# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Backend origin or API root for separately hosted frontend deployments.
VITE_API_BASE_URL=https://your-render-service.onrender.com/api

# PORT: Server port (defaults to 3000)
PORT=3000

# NODE_ENV: development or production
NODE_ENV="development"

# CORS_ORIGINS: Comma-separated list of allowed browser origins.
# Set the production origins explicitly; development defaults to http://localhost:3000.
CORS_ORIGINS=http://localhost:3000

# JWT_SECRET: Generate a private, random secret of at least 32 characters.
JWT_SECRET="replace_with_a_private_random_secret_at_least_32_characters"

# MONGODB_URI: Private MongoDB Atlas connection string. URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://db_user:db_password@onlineshopping.5mvnujh.mongodb.net/aura_store?retryWrites=true&w=majority

# Optional development-only DNS override for Node.js SRV lookups when the system resolver fails.
# DNS queries from this Node process will be sent to these servers instead of the system resolver.
# Use only a resolver approved for your network. Example: MONGODB_DNS_SERVERS=8.8.8.8
# This setting is rejected when NODE_ENV=production.
# MONGODB_DNS_SERVERS=

# Admin bootstrap is explicit: use npm run admin:bootstrap with a confirmed non-production database.
# Existing accounts are never promoted or have their passwords reset by bootstrap.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# RAZORPAY TEST CREDENTIALS
# Obtain from Razorpay Dashboard -> Settings -> API Keys (in Test Mode)
# Test Key format starts with 'rzp_test_'
RAZORPAY_KEY_ID="rzp_test_YourTestKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpaySecretKeyHere"
RAZORPAY_WEBHOOK_SECRET="YourRazorpayWebhookSecretHere"

# Development demo inventory is separate from physical stock and disabled by default.
DEMO_MODE_ENABLED=false

# Production Razorpay TEST demo checkout remains disabled unless explicitly opted in.
# Set to true only with valid rzp_test_ credentials; live Razorpay keys never enable it.
PRODUCTION_TEST_DEMO_CHECKOUT_ENABLED=false

# Optional order confirmation email (Gmail SMTP; use an App Password, not your account password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-account@gmail.com
# SMTP_PASS=your-16-character-app-password
# MAIL_FROM="AURA Store <your-account@gmail.com>"
