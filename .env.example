# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT=3000

# NODE_ENV: development or production
NODE_ENV="development"

# JWT_SECRET: Strong secret key for signing authentication tokens
JWT_SECRET="replace_with_a_long_random_secret"

# MONGODB_URI: MongoDB Atlas connection string (or local mongodb://localhost:27017/aura_ecommerce)
# This build currently uses persistent file-backed document storage in ./data/.
# Keep this placeholder until a MongoDB persistence adapter is intentionally added.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/aura_ecommerce?retryWrites=true&w=majority"

# RAZORPAY TEST CREDENTIALS
# Obtain from Razorpay Dashboard -> Settings -> API Keys (in Test Mode)
# Test Key format starts with 'rzp_test_'
RAZORPAY_KEY_ID="rzp_test_YourTestKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpaySecretKeyHere"
RAZORPAY_WEBHOOK_SECRET="YourRazorpayWebhookSecretHere"
