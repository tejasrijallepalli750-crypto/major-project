# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT=3000

# NODE_ENV: development or production
NODE_ENV="development"

# JWT_SECRET: Generate a private, random secret of at least 32 characters.
JWT_SECRET="replace_with_a_private_random_secret_at_least_32_characters"

# MONGODB_URI: Private MongoDB Atlas connection string. URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://db_user:db_password@onlineshopping.5mvnujh.mongodb.net/aura_store?retryWrites=true&w=majority

# Optional development-only DNS override for Node.js SRV lookups when the system resolver fails.
# DNS queries from this Node process will be sent to these servers instead of the system resolver.
# Use only a resolver approved for your network. Example: MONGODB_DNS_SERVERS=8.8.8.8
# This setting is rejected when NODE_ENV=production.
# MONGODB_DNS_SERVERS=

# Optional initial administrator. Created only if this email does not already exist.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# RAZORPAY TEST CREDENTIALS
# Obtain from Razorpay Dashboard -> Settings -> API Keys (in Test Mode)
# Test Key format starts with 'rzp_test_'
RAZORPAY_KEY_ID="rzp_test_YourTestKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpaySecretKeyHere"
RAZORPAY_WEBHOOK_SECRET="YourRazorpayWebhookSecretHere"
